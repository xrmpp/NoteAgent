APP_TITLE=NoteAgent
STREAMLIT_SERVER_PORT=8501
MODEL_PROVIDER=openai_compatible
MODEL_NAME=gpt-4o-mini
STRUCTURED_TEMPERATURE=0
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
EMBEDDING_PROVIDER=hash
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=32
EMBEDDING_TIMEOUT_SECONDS=30
# Local BGE-M3 through Ollama's OpenAI-compatible endpoint:
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# EMBEDDING_API_KEY=local
# EMBEDDING_MODEL=bge-m3
# EMBEDDING_DIMENSIONS=1024
# EMBEDDING_BATCH_SIZE=8
# EMBEDDING_TIMEOUT_SECONDS=180
RERANK_ENABLED=false
RAG_GENERATION_ENABLED=true
RAG_GENERATION_MAX_CHUNKS=5
RAG_GENERATION_CONTEXT_CHARS=4000
# Streamlit only needs the API address and APP_TITLE; model/database settings belong to the API.
# For a standalone UI outside Docker, export AGENT_API_BASE_URL=http://127.0.0.1:8001.
AGENT_API_BASE_URL=http://api:8000
# DeepSeek example:
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_API_KEY=your_deepseek_api_key
# MODEL_NAME=deepseek-v4-flash
# Alternative DeepSeek model:
# MODEL_NAME=deepseek-v4-pro
OLLAMA_BASE_URL=http://host.docker.internal:11434
DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/ai_agent
PRIMARY_THREAD_TITLE=Primary Thread
# Set false for a personal knowledge base to avoid reseeding demo documents after deleting all sources.
AUTO_INGEST_DEMO_CORPUS=true
MAX_CONTEXT_MESSAGES=20
